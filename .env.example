# Copy this file to .env and change the passwords. Never commit .env.
POSTGRES_DB=research_commons
POSTGRES_USER=rc_admin
POSTGRES_PASSWORD=replace_with_a_unique_database_password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_unique_minio_password

# Used to sign login tokens (JWT). Generate a private random value; never commit .env.
JWT_SECRET=replace_with_a_long_random_secret
